# Copy to .env and customize as needed
OMNI_DB_PATH=data/omni_monitor.db
OMNI_HOST=0.0.0.0
OMNI_PORT=8080
OMNI_API_KEY=
OMNI_SCHEDULER_ENABLED=true
OMNI_SCHEDULER_TICK_SECONDS=10
OMNI_SEED_DEFAULTS=true

# Google Firebase Cloud Messaging (Service Account JSON path)
# Leave empty to run in dry-run/console mode before configuring Firebase
OMNI_FCM_CREDENTIALS_PATH=

# Optional internal LOF monitor endpoint (e.g. http://lof-monitor:8000/api/funds)
OMNI_LOF_API_URL=
